# 监听地址与端口（waliapi-web 实际读取的变量名；--host/--port 参数可覆盖）
WALIAPI_SERVER_HOST=127.0.0.1
WALIAPI_SERVER_PORT=8777
WALIAPI_DATA_DIR=/var/lib/waliapi
WALIAPI_TARGET_HOME=/var/lib/waliapi/managed-home
# Public HTTPS origin used when generating client application configs.
# WALIAPI_PUBLIC_URL=https://waliapi.example.com
# Protects KB/Wiki REST endpoints (/api/kb, /api/wiki), Bearer auth.
# Generate with: openssl rand -hex 32
WALIAPI_ADMIN_TOKEN=replace-with-a-long-random-token
# Separate least-privilege credential for external MCP clients/Agents (/mcp).
# It must not equal WALIAPI_ADMIN_TOKEN. Unset = MCP endpoint disabled (401).
WALIAPI_MCP_TOKEN=replace-with-a-different-long-random-token
